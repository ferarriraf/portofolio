# Réglages d'envoi du formulaire de contact.
#
# À recopier dans un fichier « .env.local » à la racine (jamais versionné),
# et à saisir aussi dans le manager Infomaniak, section variables
# d'environnement du site Node.
#
# Sans ces valeurs, le formulaire ne fait pas semblant : il affiche
# honnêtement qu'il est indisponible et renvoie vers l'adresse email.

SMTP_HOTE=mail.infomaniak.com
SMTP_PORT=465
SMTP_UTILISATEUR=contact@r-x.fr

# Le mot de passe de la boîte mail. Il ne doit exister que dans le
# .env.local local et dans le manager Infomaniak — jamais dans le dépôt.
SMTP_MOTDEPASSE=

# Où arrivent les messages. Vide = la boîte ci-dessus.
CONTACT_DESTINATAIRE=contact@r-x.fr
